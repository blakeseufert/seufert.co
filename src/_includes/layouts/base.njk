<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} | {% endif %}{{ site.name }}</title>
    <meta name="description" content="{{ excerpt or site.description }}">
    <meta name="theme-color" content="#efede9">
    <meta name="site-base-path" content="{{ '/' | withBasePath }}">
    <script>
      (() => {
        try {
          if (!sessionStorage.getItem("seufertNameIntroPlayed")) {
            document.documentElement.classList.add("profile-name-first-load");
            sessionStorage.setItem("seufertNameIntroPlayed", "true");
          }
        } catch {
          document.documentElement.classList.add("profile-name-first-load");
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Sura:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/styles.css?v={{ site.assetVersion }}">
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="topbar" aria-label="Site header">
      <nav class="icon-links" aria-label="Social links">
        {% for item in site.social %}
          <a class="icon-link" href="{{ item.url }}" aria-label="{{ item.label }}">
            {% if item.label == "Email" %}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.75 6.75h14.5v10.5H4.75z"/><path d="m5.25 7.25 6.75 5.5 6.75-5.5"/></svg>
            {% elif item.label == "LinkedIn" %}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 10.5v7"/><path d="M6.5 6.75v.05"/><path d="M10.5 17.5v-7"/><path d="M10.5 13.4c0-1.8 1.15-3.1 2.9-3.1 1.65 0 2.6 1.05 2.6 3.05v4.15"/></svg>
            {% else %}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.25 18.5c-3.25 1-3.25-1.6-4.55-2"/><path d="M13.25 21v-3.25c0-.95.1-1.35-.45-1.9 2.6-.3 5.35-1.3 5.35-5.75a4.5 4.5 0 0 0-1.2-3.1 4.2 4.2 0 0 0-.05-3.05s-.95-.3-3.15 1.2a10.7 10.7 0 0 0-5.75 0c-2.2-1.5-3.15-1.2-3.15-1.2A4.2 4.2 0 0 0 4.8 7a4.5 4.5 0 0 0-1.2 3.1c0 4.45 2.75 5.45 5.35 5.75-.55.55-.55 1.1-.45 1.9V21"/></svg>
            {% endif %}
            <span class="pill pill--small social-pill">
              <svg class="pill__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 12.5 15.5 16.5"/><path d="M15.5 7.5 8.5 11.5"/><circle cx="6.5" cy="12" r="2"/><circle cx="17.5" cy="6.5" r="2"/><circle cx="17.5" cy="17.5" r="2"/></svg>
              <span>{{ item.contact }}</span>
            </span>
          </a>
        {% endfor %}
      </nav>
      <a class="site-mark" href="/">{{ site.name }}</a>
    </header>
    <main id="content">
      {{ content | safe }}
    </main>
    <script src="/assets/js/site.js?v={{ site.assetVersion }}" defer></script>
  </body>
</html>
