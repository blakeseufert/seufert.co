<div class="site-shell">
  {% set postData = post.data if post.data else {
    title: title,
    tags: tags,
    cover: cover,
    coverAlt: coverAlt,
    excerpt: excerpt
  } %}
  {% set postDate = post.date or page.date %}
  {% set postUrl = post.url or page.url %}
  <aside class="profile-panel" aria-label="About {{ site.author }}">
    <nav class="icon-links profile-panel__social" aria-label="Social links">
      {% for item in site.social %}
        <a class="icon-link" href="{{ item.url }}" aria-label="{{ item.label }}">
          {% if item.label == "Email" %}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.75 6.75h14.5v10.5H4.75z"/><path d="m5.25 7.25 6.75 5.5 6.75-5.5"/></svg>
          {% elif item.label == "LinkedIn" %}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 10.5v7"/><path d="M6.5 6.75v.05"/><path d="M10.5 17.5v-7"/><path d="M10.5 13.4c0-1.8 1.15-3.1 2.9-3.1 1.65 0 2.6 1.05 2.6 3.05v4.15"/></svg>
          {% else %}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.25 18.5c-3.25 1-3.25-1.6-4.55-2"/><path d="M13.25 21v-3.25c0-.95.1-1.35-.45-1.9 2.6-.3 5.35-1.3 5.35-5.75a4.5 4.5 0 0 0-1.2-3.1 4.2 4.2 0 0 0-.05-3.05s-.95-.3-3.15 1.2a10.7 10.7 0 0 0-5.75 0c-2.2-1.5-3.15-1.2-3.15-1.2A4.2 4.2 0 0 0 4.8 7a4.5 4.5 0 0 0-1.2 3.1c0 4.45 2.75 5.45 5.35 5.75-.55.55-.55 1.1-.45 1.9V21"/></svg>
          {% endif %}
        </a>
      {% endfor %}
    </nav>
    <div class="profile-panel__portrait" aria-hidden="true">
      {% for i in [1, 2, 3, 4, 5, 6, 7, 8] %}
        <span class="profile-panel__streak profile-panel__streak--{{ i }}"></span>
      {% endfor %}
      <img class="profile-panel__image" src="{{ site.profileImage }}" alt="">
    </div>
    <h1 class="profile-panel__name">{{ site.author }}</h1>
    <p class="profile-panel__tagline">{{ site.tagline }}</p>

    <div class="role-list" aria-label="Roles">
      {% for role in site.roles %}
        <section class="role-list__item">
          <p><strong>{{ role.org }}</strong> <span>{{ role.title }}</span></p>
          {% if role.links %}
            <div class="role-list__links" aria-label="{{ role.org }} links">
              {% for link in role.links %}
                <span class="pill pill--small role-list__badge role-list__badge--{{ link.tone }}">
                  {% if link.icon %}
                    <img class="role-list__badge-icon" src="{{ link.icon }}?v={{ site.assetVersion }}" alt="" loading="lazy">
                  {% endif %}
                  {{ link.label }}
                </span>
              {% endfor %}
            </div>
          {% endif %}
        </section>
      {% endfor %}
    </div>

    <p class="profile-panel__bio">{{ site.bio }}</p>
    <a class="profile-panel__more" href="mailto:hello@seufert.co">More About Blake <span aria-hidden="true">⌄</span></a>
    <p class="profile-panel__made">Made with <a href="/editor/" aria-label="Open editor">♥</a> in Melbourne</p>
  </aside>

  <article class="article-layout">
    <header class="article-hero">
      <div class="article-kicker">
        {% for tag in postData.tags or [] %}
          {% if tag != "posts" %}
            <span class="pill">{{ tag }}</span>
          {% endif %}
        {% endfor %}
      </div>
      <h1>{{ postData.title }}</h1>
      {% if postData.cover %}
        <img class="article-cover" src="{{ postData.cover }}" alt="{{ postData.coverAlt or postData.title }}">
      {% endif %}
      <div class="article-meta">
        <time datetime="{{ postDate | isoDate }}">{{ postDate | readableDate }}</time>
        <button class="pill pill--button article-share" type="button" onclick="navigator.share ? navigator.share({ title: document.title, url: location.href }) : navigator.clipboard.writeText(location.href)">
          <svg class="pill__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 12.5 15.5 16.5"/><path d="M15.5 7.5 8.5 11.5"/><circle cx="6.5" cy="12" r="2"/><circle cx="17.5" cy="6.5" r="2"/><circle cx="17.5" cy="17.5" r="2"/></svg>
          <span>Share</span>
        </button>
      </div>
    </header>

    <div class="post-body">
      {% if post.templateContent %}
        {{ post.templateContent | safe }}
      {% else %}
        {{ content | safe }}
      {% endif %}
    </div>

    <footer class="more-posts" aria-label="Posts">
      {% for item in collections.posts %}
        {% set isCurrentPost = item.url == postUrl %}
        <a class="more-post{% if isCurrentPost %} more-post--current{% endif %}" href="{{ item.url }}"{% if isCurrentPost %} aria-current="page"{% endif %}>
          {% if item.data.cover %}
            <img src="{{ item.data.cover }}" alt="" loading="lazy">
          {% endif %}
          <span class="more-post__title">{{ item.data.title }}</span>
          <span class="more-post__meta">
            <time datetime="{{ item.date | isoDate }}">{{ item.date | readableDate }}</time>
            {% if isCurrentPost %}
              <span class="pill pill--small more-post__current">Current</span>
            {% endif %}
          </span>
        </a>
      {% endfor %}
    </footer>
    <div class="site-watermark" aria-hidden="true">{{ site.name }}</div>
  </article>
</div>
