<div class="site-shell">
  {% set postData = post.data if post.data else {
    title: title,
    tags: tags,
    cover: cover,
    coverAlt: coverAlt,
    excerpt: excerpt
  } %}
  {% set postDate = post.date or page.date %}
  {% set postUrl = post.url or page.url %}
  <aside class="profile-panel" aria-label="About {{ site.author }}">
    <div class="profile-panel__portrait" aria-hidden="true">
      {% for i in [1, 2, 3, 4, 5, 6, 7, 8] %}
        <span class="profile-panel__streak profile-panel__streak--{{ i }}"></span>
      {% endfor %}
      <img class="profile-panel__image" src="{{ site.profileImage }}" alt="">
    </div>
    <h1 class="profile-panel__name">{{ site.author }}</h1>
    <p class="profile-panel__tagline">{{ site.tagline }}</p>

    <div class="role-list" aria-label="Roles">
      {% for role in site.roles %}
        <section class="role-list__item">
          <p><strong>{{ role.org }}</strong> <span>{{ role.title }}</span></p>
          {% if role.links %}
            <div class="role-list__links" aria-label="{{ role.org }} links">
              {% for link in role.links %}
                {% if link.url %}
                  <a class="pill pill--small role-list__badge role-list__badge--{{ link.tone }}" href="{{ link.url }}" target="_blank" rel="noreferrer">
                {% else %}
                  <span class="pill pill--small role-list__badge role-list__badge--{{ link.tone }}">
                {% endif %}
                  {% if link.icon %}
                    <img class="role-list__badge-icon" src="{{ link.icon }}?v={{ site.assetVersion }}" alt="" loading="lazy">
                  {% endif %}
                  {{ link.label }}
                {% if link.url %}
                  </a>
                {% else %}
                  </span>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </section>
      {% endfor %}
    </div>

    <div class="profile-panel__bio" data-profile-bio>
      <p>{{ site.bioIntro }}</p>
      <div class="profile-panel__bio-more" id="profile-bio-more" hidden>
        {% for paragraph in site.bioMore %}
          <p>{{ paragraph }}</p>
        {% endfor %}
      </div>
    </div>
    <button class="profile-panel__more" type="button" aria-expanded="false" aria-controls="profile-bio-more" data-profile-bio-toggle>
      <span data-profile-bio-label>More About Blake</span>
      <img class="profile-panel__chevron" src="/assets/uploads/icons/chevron-down.svg?v={{ site.assetVersion }}" alt="" aria-hidden="true">
    </button>
    <p class="profile-panel__made">Made with <a class="profile-panel__heart-link" href="/editor/" aria-label="Open editor"><svg class="profile-panel__heart" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.2 5.45 13.98C2.2 10.9 3.86 5.5 8.24 5.5c1.58 0 2.87.74 3.76 1.9.89-1.16 2.18-1.9 3.76-1.9 4.38 0 6.04 5.4 2.79 8.48L12 20.2Z"/></svg></a> in Melbourne</p>
  </aside>

  <article class="article-layout">
    <header class="article-hero">
      <div class="article-kicker">
        {% for tag in postData.tags or [] %}
          {% if tag != "posts" %}
            <span class="pill">{{ tag }}</span>
          {% endif %}
        {% endfor %}
      </div>
      <h1>{{ postData.title }}</h1>
      {% if postData.cover %}
        <img class="article-cover" src="{{ postData.cover }}" alt="{{ postData.coverAlt or postData.title }}">
      {% endif %}
      <div class="article-meta">
        <time datetime="{{ postDate | isoDate }}">{{ postDate | readableDate }}</time>
        <div class="share-cluster" data-share-cluster>
          <button class="pill pill--button article-share" type="button" aria-expanded="false" data-share-toggle>
            <svg class="pill__icon article-share__icon article-share__icon--share" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 12.5 15.5 16.5"/><path d="M15.5 7.5 8.5 11.5"/><circle cx="6.5" cy="12" r="2"/><circle cx="17.5" cy="6.5" r="2"/><circle cx="17.5" cy="17.5" r="2"/></svg>
            <svg class="pill__icon article-share__icon article-share__icon--close" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12"/><path d="M18 6 6 18"/></svg>
            <span data-share-label>Share</span>
          </button>
          <div class="share-options" aria-label="Share this post" data-share-options>
            <a class="pill pill--small share-option" href="#" target="_blank" rel="noopener" data-share-target="twitter">Twitter</a>
            <a class="pill pill--small share-option" href="#" data-share-target="email">Email</a>
            <a class="pill pill--small share-option" href="#" target="_blank" rel="noopener" data-share-target="linkedin">LinkedIn</a>
          </div>
        </div>
      </div>
    </header>

    <div class="post-body">
      {% if post.templateContent %}
        {{ post.templateContent | safe }}
      {% else %}
        {{ content | safe }}
      {% endif %}
    </div>

    <footer class="more-posts" aria-label="Posts">
      {% for item in collections.posts %}
        {% set isCurrentPost = item.url == postUrl %}
        <a class="more-post{% if isCurrentPost %} more-post--current{% endif %}" href="{{ item.url }}"{% if isCurrentPost %} aria-current="page"{% endif %}>
          {% if item.data.cover %}
            <img src="{{ item.data.cover }}" alt="" loading="lazy">
          {% endif %}
          <span class="more-post__title">{{ item.data.title }}</span>
          <span class="more-post__meta">
            <time datetime="{{ item.date | isoDate }}">{{ item.date | readableDate }}</time>
          </span>
        </a>
      {% endfor %}
    </footer>
    <div class="site-watermark" aria-hidden="true">{{ site.name }}</div>
    <footer class="mobile-site-footer" aria-label="Site footer">
      <p class="profile-panel__made">Made with <a class="profile-panel__heart-link" href="/editor/" aria-label="Open editor"><svg class="profile-panel__heart" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.2 5.45 13.98C2.2 10.9 3.86 5.5 8.24 5.5c1.58 0 2.87.74 3.76 1.9.89-1.16 2.18-1.9 3.76-1.9 4.38 0 6.04 5.4 2.79 8.48L12 20.2Z"/></svg></a> in Melbourne</p>
    </footer>
  </article>
</div>
